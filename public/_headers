# Cloudflare Pages security headers. Applied to every response.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Hashed Next.js assets are immutable: cache hard.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Pregenerated audio: hash-named, an toàn cache dài hạn (>= 7 ngày).
# Đổi nội dung -> đổi hash -> đổi URL, nên không lo cache cũ.
/audio/*
  Cache-Control: public, max-age=604800, immutable
